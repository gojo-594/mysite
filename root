:root {
  --bg: #f4f7fb;
  --panel: #ffffff;
  --panel-alt: #edf3ff;
  --text: #1d2433;
  --muted: #5e6a7a;
  --primary: #2e6df6;
  --primary-dark: #1f56d0;
  --border: #dfe7f5;
  --shadow: 0 12px 28px rgba(26, 42, 72, 0.08);
}

body.dark {
  --bg: #101827;
  --panel: #172334;
  --panel-alt: #1e2d45;
  --text: #edf3ff;
  --muted: #b7c4d8;
  --primary: #6ea8ff;
  --primary-dark: #90bcff;
  --border: #2d3c52;
  --shadow: 0 12px 26px rgba(0, 0, 0, 0.25);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1rem 5vw;
  background: rgba(255, 255, 255, 0.8);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(8px);
}

body.dark .topbar {
  background: rgba(16, 24, 39, 0.8);
}

.brand {
  font-size: 1.3rem;
  font-weight: 700;
}

.nav {
  display: flex;
  gap: 1.2rem;
  flex-wrap: wrap;
}

.nav a {
  color: var(--muted);
  font-weight: 600;
}

.nav a:hover {
  color: var(--text);
}

.toggle,
.button {
  border: none;
  border-radius: 10px;
  cursor: pointer;
  transition: 0.2s ease;
}

.toggle {
  padding: 0.7rem 1rem;
  background: var(--panel-alt);
  color: var(--text);
  font-weight: 700;
}

.button {
  display: inline-block;
  padding: 0.8rem 1.2rem;
  font-weight: 700;
  text-align: center;
}

.primary {
  background: var(--primary);
  color: white;
}

.primary:hover {
  background: var(--primary-dark);
}

.secondary {
  background: var(--panel);
  color: var(--text);
  border: 1px solid var(--border);
}

main {
  width: min(1100px, 90vw);
  margin: 0 auto;
  padding: 2rem 0 4rem;
}

.hero {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 2rem;
  align-items: center;
  min-height: 60vh;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--primary);
}

.hero h1 {
  font-size: clamp(2.2rem, 5vw, 4rem);
  line-height: 1.1;
  margin: 0.4rem 0 1rem;
}

.hero-text p {
  color: var(--muted);
  font-size: 1.05rem;
  max-width: 60ch;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  margin-top: 1.3rem;
}

.hero-card,
.panel,
.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: var(--shadow);
}

.hero-card {
  padding: 1.5rem;
}

.mini-label {
  display: inline-block;
  background: var(--panel-alt);
  color: var(--primary);
  font-weight: 700;
  border-radius: 999px;
  padding: 0.35rem 0.75rem;
  font-size: 0.8rem;
}

.hero-card h2 {
  margin: 1rem 0 0.8rem;
}

.hero-card ul {
  margin: 0;
  padding-left: 1.2rem;
  color: var(--muted);
}

.panel {
  margin-top: 2rem;
  padding: 1.5rem;
}

.panel h2 {
  margin-top: 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1rem;
  margin-top: 1rem;
}

.card {
  padding: 1rem;
}

.card h3 {
  margin-top: 0;
}

.contact p {
  margin: 0.4rem 0;
}

.footer {
  text-align: center;
  padding: 1rem;
  color: var(--muted);
}

@media (max-width: 760px) {
  .topbar {
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .nav {
    justify-content: center;
  }
}
